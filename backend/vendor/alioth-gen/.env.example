# AliothStudio Meta Model - Database Configuration
# Copy this file to .env and update with your actual values

# ============================================
# Version Information
# ============================================
# Alioth 模型版本
MODEL_VERSION=10.0.0
# AliothStudio 平台版本
STUDIO_VERSION=0.1.1
# 应用程序版本
APP_VERSION=0.0.1

# ============================================
# PostgreSQL Database URL
# ============================================
# Format: postgres://user:password@host:port/database
# Default: postgres://localhost:5432/aliothstudio
DATABASE_URL=postgres://localhost:5432/aliothstudio

# Alternative: Split configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=aliothstudio
PGUSER=postgres
PGPASSWORD=

# ============================================
# Apache AGE Configuration
# ============================================
# Graph name for NGAC policy data
AGE_GRAPH_NAME=isahl_auth

# Enable AGE extension loading
AGE_ENABLE=true

# ============================================
# Connection Pool Settings
# ============================================
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_CONNECT_TIMEOUT=30
DB_IDLE_TIMEOUT=300

# ============================================
# Schema Settings
# ============================================

# ============================================
# Logging
# ============================================
RUST_LOG=info
SQLX_LOG=warn
