# AppCreator Backend 环境变量

# 服务器监听地址
SERVER_ADDR=127.0.0.1:49495

# 数据库连接（dev-appcreator.sh 会自动注入当前用户，此处仅做格式参考）
DATABASE_URL=postgres://isahl@localhost:5432/aliothstudio_dev

# Rust 日志级别
RUST_LOG=info

# 数据库连接池
DATABASE_POOL_SIZE=5

# LLM 配置（AppAgent 必需）
# 支持的 provider：kimi / minimax / deepseek，默认 deepseek
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-pro
# LLM_FLASH_MODEL=

# Standalone 模式 ES256 私钥（PKCS#8 PEM，enc: 密文存储）
# 不配则使用嵌入式开发密钥（仅限本地开发，重启后 token 仍有效）
# APP_CREATOR_JWT_PRIVATE_KEY=

# ── SSO 模式配置（启用 SSO 认证 + OAuth GitHub/WeChat 时必配） ──
# SSO 公钥（ES256，.env 中配置，用于验证 SSO 签发的 JWT）
# 从 SSO/backend/.env 或 SSO JWKS 端点获取
# SSO_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...

# AppCreator 前端基址（SSO OAuth 回调用）
# dev-appcreator.sh 自动设置，生产环境需自行配置
# APPCREATOR_FRONTEND_URL=http://localhost:49496
