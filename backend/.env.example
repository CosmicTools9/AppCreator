# AppCreator Backend 环境变量

# 服务器监听地址
SERVER_ADDR=127.0.0.1:49495

# 数据库连接（可选，默认使用 Gateway 同名数据库）
DATABASE_URL=postgres://localhost:5432/aliothstudio_dev

# Rust 日志级别
RUST_LOG=info

# 数据库连接池
DATABASE_POOL_SIZE=5

# LLM 配置（AppAgent 必需）
# 支持的 provider：kimi / minimax / deepseek，默认 deepseek
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-pro
# LLM_FLASH_MODEL=
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=300
# LLM_MAX_RETRIES=3
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096
# LLM_REASONING_EFFORT=medium
# LLM_RESPONSE_FORMAT=
